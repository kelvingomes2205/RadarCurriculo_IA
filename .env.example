# ==========================================
# Radar Currículo IA - Configuração de Ambiente
# ==========================================

# 1. Chave da OpenAI (Centralizada para uso da IA Generativa)
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui

# 2. Mercado Pago (Access Token para geração de cobranças PIX)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui

# 3. Google OAuth 2.0 (Autenticação com Gmail)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8501
